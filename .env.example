# Supabase PostgreSQL Database Connection String (Transaction Pooler - port 6543)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Configuration (Found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket for logos and media uploads (Public bucket)
SUPABASE_STORAGE_BUCKET=media

# Public Site & WhatsApp Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+919121086779

